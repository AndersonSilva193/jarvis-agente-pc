# Configuração do agente do Jarvis neste PC.
# Copie para config.properties (que está no .gitignore) e preencha.

# Onde o Jarvis atende. Só https: o pcToken viaja no cabeçalho Authorization, e em texto claro
# vazaria em qualquer rede do caminho.
urlApi=https://jarvis.barberagendaonline.store

# O MESMO valor do PC_TOKEN que está no .env da VPS. Gere um com: openssl rand -hex 32
pcToken=

# Computer use no monitor principal. Recurso validado neste PC; vem desligado por padrao para
# ninguem ganhar controle de mouse e teclado sem pedir. Precisa de true aqui E de
# COMPUTER_USE_ATIVO=true na VPS.
# Parada local: Ctrl+Alt+Shift+F12 ou menu do icone Jarvis na bandeja.
computer.use.ativo=false

# Pasta dos arquivos criados. Vazio: pasta Documentos do Windows, subpasta Jarvis.
# Um caminho relativo parte da pasta deste config.properties.
pastaArquivos=

# Edição de TXT/MD/JSON/XLSX catalogados diretamente em pastaArquivos.
# Limites em bytes; a cópia e o original são revalidados no commit.
edicao.maxBytesArquivo=1048576
edicao.maxOperacoes=10
edicao.maxBytesResultado=1048576
edicao.maxBytesPrevia=12000
edicao.maxVersoesBackup=10
edicao.maxBytesBackup=104857600

# ---- Lixeira ----
# Apagar arquivo da pastaArquivos e reversivel: a acao mover_para_lixeira guarda o arquivo em
# <pastaArquivos>/.lixeira/AAAA-MM-DD/ com um registro ao lado, listar_lixeira mostra o que esta
# la e restaurar_da_lixeira devolve o arquivo ao lugar -- com sufixo, se o nome ja estiver
# ocupado, e com um ID NOVO de catalogo (o antigo morre junto com a entrada).
# Passados estes dias, o item e apagado de vez: o expurgo roda na partida e uma vez por dia.
# A .lixeira fica fora do listar_arquivos comum, e nada que o agente nao reconheca dentro dela
# e apagado. Fora do intervalo 1..3650 o agente nao sobe.
lixeira.diasRetencao=30

# ---- IA local (Ollama) ----
# A VPS pode mandar a acao inferir: o agente chama o Ollama DESTE PC e devolve a resposta, sem
# abrir porta nenhuma. Vem desligado; ligue so com o Ollama instalado e o modelo baixado
# (ollama pull qwen3.5:9b).
ollama.ativo=false
# So http://127.0.0.1 ou http://localhost (com porta). Qualquer outro endereco desliga a IA, com
# aviso no log: o agente nao vira ponte da VPS para a rede local.
ollama.url=http://127.0.0.1:11434
# Modelo, contexto (num_ctx) e keep_alive sao decididos aqui; o que vier da VPS e ignorado.
ollama.modelo=qwen3.5:9b
ollama.contexto=8192
ollama.keepAlive=20m
# Tempo maximo de uma inferencia, incluindo carregar o modelo na GPU (1..600).
ollama.timeoutSegundos=90
# Teto do pedido vindo da VPS e da resposta devolvida, em KiB (1..8192). As outras consultas
# continuam com o limite de 32 KB.
inferencia.maxKib=256

# A tela do Jarvis: é ela que a ação abrir_hud abre e que a palavra "Jarvis" acende.
# Também só https. Sem esta linha, o despertar fica desligado — não haveria para onde acordar.
urlHud=https://jarvis-hud-gamma.vercel.app

# ---- Programa em primeiro plano ----
# A cada consulta de comandos vai o cabecalho X-Pc-Foco com o NOME do processo em primeiro plano
# (ex.: chrome, Code, WINWORD). Nunca o titulo da janela: ele pode ter nome de arquivo, assunto
# de e-mail ou texto de pagina. Leitura a cada 30 s no maximo; nome fora de [A-Za-z0-9._-] ou
# acima de 40 caracteres, ou qualquer falha, e cabecalho ausente. false desliga o cabecalho.
reportarFoco=true

# ---- Despertar ----
# Duas palmas ou a palavra "Jarvis" abrem a tela, e o Jarvis se apresenta falando.
# Os dois gatilhos dividem o mesmo microfone e valem ao mesmo tempo.
# O reconhecimento é TODO offline, aqui no PC: nenhum áudio sai desta máquina antes do gatilho.
# Depois que a tela abre, o agente SOLTA o microfone — quem escuta passa a ser a própria HUD.

# Duas palmas com 200 a 700 ms entre elas. Tres ou mais sao ignoradas: e aplauso, nao chamado.
gatilho.palmas=true

# A palavra de chamado "Jarvis" usa whisper.cpp e modelo base multilingue, todos locais.
# Instale com baixar-modelo.ps1 (~145 MB).
gatilho.voz=true

# Parte do nome do microfone, sem diferenciar maiúsculas (ex.: "Yeti", "Realtek", "USB Microphone").
# Vazio usa o microfone padrão do Windows -- que troca sem aviso quando voce liga um fone, e os
# microfones tem sensibilidade bem diferente. Com palmas ligadas, vale fixar o seu pelo nome.
microfone=

# Quanto a palma precisa passar do ruido de fundo, em dB. Depende da sala, do microfone e da
# distancia: meca o seu com --calibrar (veja o README). Se a tela abrir sozinha, suba de 2 em 2;
# se as palmas nao forem reconhecidas, desca. Cada disparo loga quantos dB a palma passou do
# ruido -- subir o limiar acima desse numero passa a exigir palma forte.
palmas.sensibilidadeDb=18

# Caminhos relativos a este config.properties, nunca ao diretorio atual.
voz.executavel=ferramentas/whisper/whisper-cli.exe
voz.modelo=modelos/ggml-base.bin
# Media minima das probabilidades dos tokens da palavra "Jarvis" no Whisper.
voz.probabilidadeMinima=0.6

# Como a tela abre:
#   app   - janela sem barra de endereço, em tela cheia (dá para sair com Alt+F4)
#   kiosk - tela cheia travada
hud.modo=app

# Em repouso, impedir o PC de suspender. O monitor continua apagando normalmente; o que isto
# evita é o PC dormir enquanto aguarda o comando de voz. Confira com:  powercfg /requests
energia.manterPcAcordado=true

# ---- Apps liberados ----
# app.<nome>=<caminho do .exe>
#
# Esta lista é a única fonte de verdade: o Jarvis conhece apenas os NOMES daqui (eles vão no
# cabeçalho X-Pc-Apps a cada consulta e viram a lista que o modelo pode escolher), nunca os
# caminhos. Tirar uma linha daqui tira o app do alcance do Jarvis na hora, sem rebuild de nada.
# Caminho que não existe mais é ignorado na partida, com aviso no log.
#
# O nome aceita letras minúsculas, números, _, . e -.
#
# app.chrome é obrigatório para o despertar: é o Chrome que abre a tela.
app.chrome=C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe
app.vscode=C:\\Users\\SEU_USUARIO\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe
app.intellij=C:\\Program Files\\JetBrains\\IntelliJ IDEA\\bin\\idea64.exe
app.spotify=C:\\Users\\SEU_USUARIO\\AppData\\Roaming\\Spotify\\Spotify.exe

# Hermes3D: com as quatro chaves, o agente liga o escritório junto com o Windows.
# Use barras normais nos caminhos. O token é o HERMES_API_KEY do .env do Hermes3D.
#hermes3d.pasta=C:/Users/voce/Desktop/Hermes3D
#hermes3d.node=C:/Program Files/nodejs/node.exe
#hermes3d.hermes=C:/Users/voce/AppData/Local/hermes/bin/hermes.exe
#hermes3d.token=
