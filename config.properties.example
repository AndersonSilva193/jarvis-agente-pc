# Configuração do agente do Jarvis neste PC.
# Copie para config.properties (que está no .gitignore) e preencha.

# Onde o Jarvis atende. Só https: o pcToken viaja no cabeçalho Authorization, e em texto claro
# vazaria em qualquer rede do caminho.
urlApi=https://jarvis.barberagendaonline.store

# O MESMO valor do PC_TOKEN que está no .env da VPS. Gere um com: openssl rand -hex 32
pcToken=

# A tela do Jarvis: é ela que a ação abrir_hud abre e que "Jarvis, iniciar" acende.
# Também só https. Sem esta linha, o despertar fica desligado — não haveria para onde acordar.
urlHud=https://jarvis-hud-gamma.vercel.app

# ---- Despertar ----
# Duas palmas ou "Jarvis, iniciar" abrem a tela, e o Jarvis se apresenta falando.
# Os dois gatilhos dividem o mesmo microfone e valem ao mesmo tempo.
# O reconhecimento é TODO offline, aqui no PC: nenhum áudio sai desta máquina antes do gatilho.
# Depois que a tela abre, o agente SOLTA o microfone — quem escuta passa a ser a própria HUD.

# Duas palmas com 200 a 700 ms entre elas. Tres ou mais sao ignoradas: e aplauso, nao chamado.
gatilho.palmas=true

# "Jarvis, iniciar" usa whisper.cpp e modelo base multilingue, todos locais.
# Instale com baixar-modelo.ps1 (~145 MB).
gatilho.voz=true

# Parte do nome do microfone, sem diferenciar maiúsculas (ex.: "Yeti", "Realtek", "USB Microphone").
# Vazio usa o microfone padrão do Windows -- que troca sem aviso quando voce liga um fone, e os
# microfones tem sensibilidade bem diferente. Com palmas ligadas, vale fixar o seu pelo nome.
microfone=

# Quanto a palma precisa passar do ruido de fundo, em dB. Depende da sala, do microfone e da
# distancia: meca o seu com --calibrar (veja o README). Se a tela abrir sozinha, suba de 2 em 2;
# se as palmas nao forem reconhecidas, desca. Cada disparo loga quantos dB a palma passou do
# ruido -- subir o limiar acima desse numero passa a exigir palma forte.
palmas.sensibilidadeDb=18

# Caminhos relativos a este config.properties, nunca ao diretorio atual.
voz.executavel=ferramentas/whisper/whisper-cli.exe
voz.modelo=modelos/ggml-base.bin
# Media minima das probabilidades dos tokens da palavra "iniciar" no Whisper.
voz.probabilidadeMinima=0.6

# Como a tela abre:
#   app   - janela sem barra de endereço, em tela cheia (dá para sair com Alt+F4)
#   kiosk - tela cheia travada
hud.modo=app

# Em repouso, impedir o PC de suspender. O monitor continua apagando normalmente; o que isto
# evita é o PC dormir enquanto aguarda o comando de voz. Confira com:  powercfg /requests
energia.manterPcAcordado=true

# ---- Apps liberados ----
# app.<nome>=<caminho do .exe>
#
# Esta lista é a única fonte de verdade: o Jarvis conhece apenas os NOMES daqui (eles vão no
# cabeçalho X-Pc-Apps a cada consulta e viram a lista que o modelo pode escolher), nunca os
# caminhos. Tirar uma linha daqui tira o app do alcance do Jarvis na hora, sem rebuild de nada.
# Caminho que não existe mais é ignorado na partida, com aviso no log.
#
# O nome aceita letras minúsculas, números, _, . e -.
#
# app.chrome é obrigatório para o despertar: é o Chrome que abre a tela.
app.chrome=C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe
app.vscode=C:\\Users\\SEU_USUARIO\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe
app.intellij=C:\\Program Files\\JetBrains\\IntelliJ IDEA\\bin\\idea64.exe
app.spotify=C:\\Users\\SEU_USUARIO\\AppData\\Roaming\\Spotify\\Spotify.exe
